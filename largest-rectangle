class Solution {
public:
int largestRectangleArea(vector<int>& heights) {
    int n = heights.size();
    vector<int> left(n);
    vector<int> right(n);
    stack<int> s;
    // Step 1: Har bar ke liye left boundary nikalna
    for (int i = 0; i < n; i++) {
        while (!s.empty() && heights[s.top()] >= heights[i]) {
            s.pop();
            }
            if (s.empty()) {
                left[i] = 0;
                } else {
                    left[i] = s.top() + 1;
                    }
                    s.push(i);
        }
        // Stack ko khali karna agle step ke liye
        while (!s.empty()) {
            s.pop();
        }
        // Step 2: Har bar ke liye right boundary nikalna
        for (int i = n - 1; i >= 0; i--) {
            while (!s.empty() && heights[s.top()] >= heights[i]) {
                s.pop();
            }
            if (s.empty()) {
                right[i] = n - 1;
            } else {
                right[i] = s.top() - 1;
            }
            s.push(i);
        }
        // Step 3: Max area calculate karna
        int maxArea = 0;
        for (int i = 0; i < n; i++) {
            int width = right[i] - left[i] + 1;
            int currentArea = heights[i] * width;
            if (currentArea > maxArea) {
                maxArea = currentArea;
            }
        }
        return maxArea;
    }
};
