#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

class Solution {
public:
    int trap(vector<int>& height) {
        int n = height.size();
        if (n <= 2) return 0;

        vector<int> leftMax(n);
        vector<int> rightMax(n);

        // Step 1: Left max array
        leftMax[0] = height[0];
        for (int i = 1; i < n; i++) {
            leftMax[i] = max(leftMax[i - 1], height[i]);
        }

        // Step 2: Right max array
        rightMax[n - 1] = height[n - 1];
        for (int i = n - 2; i >= 0; i--) {
            rightMax[i] = max(rightMax[i + 1], height[i]);
        }

        // Step 3: Calculate total water
        int totalWater = 0;
        for (int i = 0; i < n; i++) {
            int waterLevel = min(leftMax[i], rightMax[i]);
            if (waterLevel > height[i]) {
                totalWater += waterLevel - height[i];
            }
        }

        return totalWater;
    }
};

int main() {
    Solution sol;
    vector<int> height = {0, 1, 0, 2, 1, 0, 1, 3, 2, 1, 2, 1};
    cout << "Output: " << sol.trap(height) << endl;
    return 0;
}
// Trapping Rain Water (Prefix/Suffix Max Approach)
​Logic: Kisi bhi bar par paani tabhi rukta hai jab uske left aur right dono taraf unchi walls ho; paani ki limit dono taraf ki sabse choti max wall decide karti hai.
​Approach: leftMax aur rightMax arrays banakar har index ki max height pehle se calculate karte hain, phir har bar par min(leftMax[i], rightMax[i]) - height[i] formula se paani nikal kar add kar dete hain.
​Complexity: Time: O(N) | Space: O(N)
